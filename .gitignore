# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
.wrangler/
.mf/
.output/

# Generated at build time by scripts/sync-apps.mjs from the app folders at
# repo root (source of truth: /Proper*/index.html).
# NOTE: intentionally NOT ignored. The hosted deploy pipeline may package from
# the git snapshot rather than the working tree; if these were ignored the
# deploy would ship a launcher with no apps behind it.
# Regenerate any time with: npm run sync:apps

# Runtime / local state
.dev.vars
.env
.env.*
!.env.example
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock
.pm2/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/

# Backups
*.backup
*.bak
*.tar.gz
*.zip

# Stray shell-escape artifacts (e.g. "index.html`")
*`
